# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
# Option 1: Full Connection String (Standard or Supabase / Neon / Render / Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civic_pulse

# Option 2: Individual Connection Parameters (Fallback if DATABASE_URL is not set)
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=civic_pulse

# JWT Secret Key for Express Authentication
JWT_SECRET=civic_pulse_jwt_secret_key_sih2025_secure_token

# Cloudinary Credentials (for photo uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Demo / Fallback Mode (Set to true to allow development without live credentials)
ALLOW_DEV_AUTH_BYPASS=true
